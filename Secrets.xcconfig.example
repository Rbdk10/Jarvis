// Template. Copy to Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored — never commit real keys.
ELEVENLABS_API_KEY = your_elevenlabs_key_here
JARVIS_WS_HOST = sirjarvis.ngrok.app
JARVIS_WS_TOKEN = your_ws_token_here
JARVIS_VOICE_ID = ELng4b01d9xlW69WLEz8
// Powers the on-device "fast brain" (instant chit-chat). Get one at console.anthropic.com.
ANTHROPIC_API_KEY = your_anthropic_key_here
// Supabase (Jarvis memory DB). Publishable ("anon") key — safe to ship; RLS guards data.
// Find both in Supabase → Project Settings → API. SUPABASE_REF is the project ref.
SUPABASE_REF = your_project_ref_here
SUPABASE_PUBLISHABLE_KEY = sb_publishable_your_key_here
