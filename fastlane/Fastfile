default_platform(:ios)

platform :ios do
  desc "Bump build number, archive, and upload to TestFlight"
  lane :beta do
    # In CI, create + unlock a temporary keychain and install the signing identity into
    # it. Without this, codesign blocks on a keychain-access prompt that a headless
    # runner can never answer — the build hangs forever at "Signing Jarvis.app".
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    # XcodeGen is the source of truth for the project — regenerate before building.
    sh("cd .. && xcodegen generate")

    # Pre-ship guardrail: compile + launch the app in a simulator; abort the whole lane
    # (no upload) if it fails to build or crashes on launch. Keeps a broken build from
    # reaching TestFlight — applies whether the laptop OR the agent runs `fastlane beta`.
    sh("cd .. && bash tools/smoke_test.sh")

    # Fetch (or create if missing) ONE reusable signing identity + an App Store profile for
    # EACH bundle id — the app AND the widget extension. match reuses the single distribution
    # cert and only ever mints a *profile* per id (never a new cert), so this does NOT
    # re-trigger the "maximum number of certificates" wall. readonly:false so the first run can
    # create the widget profile the vault predates (the widget was added after match was seeded);
    # safe to tighten back to true once com.agrisol.Jarvis.Widgets is in the vault.
    match(
      type: "appstore",
      app_identifier: ["com.agrisol.Jarvis", "com.agrisol.Jarvis.Widgets"],
      api_key: api_key,
      git_url: "https://github.com/AnthonieDeKlerk78/jarvis-match.git",
      readonly: true    # vault now holds both app + widget profiles — fetch only, never create
    )

    # Next build number = one above the latest already on TestFlight.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.agrisol.Jarvis"
    )
    increment_build_number(
      xcodeproj: "Jarvis.xcodeproj",
      build_number: (latest + 1).to_s   # bumps BOTH app + widget Info.plists (agvtool -all)
    )

    # Manual signing PER TARGET with each target's own profile (set AFTER xcodegen regenerated
    # the project). No -allowProvisioningUpdates → xcodebuild never creates a new certificate.
    # CRITICAL: do NOT pass `bundle_identifier:` here — that param OVERWRITES
    # PRODUCT_BUNDLE_IDENTIFIER on every target, which silently renamed the widget to the app's
    # id and caused a TestFlight bundle-id collision (90685). Scope with `targets:` instead.
    app_profile    = ENV["sigh_com.agrisol.Jarvis_appstore_profile-name"]
    widget_profile = ENV["sigh_com.agrisol.Jarvis.Widgets_appstore_profile-name"]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Jarvis.xcodeproj",
      team_id: "6V4DVV45UP",
      code_sign_identity: "Apple Distribution",
      targets: ["Jarvis"],
      profile_name: app_profile
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Jarvis.xcodeproj",
      team_id: "6V4DVV45UP",
      code_sign_identity: "Apple Distribution",
      targets: ["JarvisWidgets"],
      profile_name: widget_profile
    )

    build_app(
      project: "Jarvis.xcodeproj",
      scheme: "Jarvis",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.agrisol.Jarvis" => app_profile,
          "com.agrisol.Jarvis.Widgets" => widget_profile
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Ship from a Mac with a signed-in Apple account (automatic signing; no match vault)"
  lane :beta_local do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    sh("cd .. && xcodegen generate")

    # Same pre-ship guardrail as `beta`: build + launch in a sim, abort on crash.
    sh("cd .. && bash tools/smoke_test.sh")

    latest = latest_testflight_build_number(api_key: api_key, app_identifier: "com.agrisol.Jarvis")
    # Bumps CFBundleVersion in BOTH the app and the widget-extension Info.plists (agvtool -all),
    # keeping them in the lockstep App Store Connect requires for app + appex.
    increment_build_number(xcodeproj: "Jarvis.xcodeproj", build_number: (latest + 1).to_s)

    # Automatic signing; the API key lets -allowProvisioningUpdates create/download the
    # cert + profile headlessly (how builds 1-13 shipped from the laptop). No match vault.
    auth = " -authenticationKeyPath #{ENV['ASC_KEY_PATH']}" \
           " -authenticationKeyID #{ENV['ASC_KEY_ID']}" \
           " -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    build_app(
      project: "Jarvis.xcodeproj",
      scheme: "Jarvis",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates#{auth}"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
